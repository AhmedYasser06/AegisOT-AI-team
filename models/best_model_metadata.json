{
    "bundle_version": 1,
    "key": "lof",
    "display_name": "LOF",
    "preprocessing": "median imputer -> RobustScaler",
    "params": {
        "n_neighbors": "30",
        "threshold_quantile": "0.99"
    },
    "threshold": 1.8202903386095501,
    "score_direction": "higher = more anomalous; flag when score > threshold",
    "n_features": 16,
    "features": [
        "motor_running",
        "speed_percent",
        "bus_voltage_v",
        "shunt_voltage_mv",
        "current_ma",
        "power_mw",
        "temperature_c",
        "accel_x_m_s2",
        "accel_y_m_s2",
        "accel_z_m_s2",
        "gyro_x_rad_s",
        "gyro_y_rad_s",
        "gyro_z_rad_s",
        "rpm",
        "acceleration_magnitude",
        "gyro_magnitude"
    ],
    "random_state": 42,
    "sklearn_version": "1.7.2",
    "model_class": "LocalOutlierFactor",
    "inference": "predict_raw(bundle, raw_frame) from pipelines.py (needs pipelines.py importable when loading)"
}