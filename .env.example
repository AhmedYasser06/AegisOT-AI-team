# ───────── LLM (provider-agnostic: Gemini by default; any LiteLLM provider works) ─────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-flash-latest
LLM_AGENTS=diagnosis,supervisor
LLM_MAX_CONCURRENT=1
LLM_ENABLED=true
# Other providers: set LLM_PROVIDER and the matching key, e.g.
#   LLM_PROVIDER=openai     OPENAI_API_KEY=...
#   LLM_PROVIDER=anthropic  ANTHROPIC_API_KEY=...
#   LLM_PROVIDER=ollama     LLM_API_BASE=http://localhost:11434      (local, no key)
# Optional exact model (otherwise a default per provider is used). Model names are retired often:
# list the ones your key can use (README section 4) and pin one, e.g.  LLM_MODEL=gemini/gemini-flash-latest
# LLM_MODEL=
# Optional different model per agent:
# LLM_MODEL_DIAGNOSIS=
# LLM_MODEL_NETWORK=
# LLM_MODEL_SECURITY=
# LLM_MODEL_MAINTENANCE=
# LLM_MODEL_SUPERVISOR=

# Free-tier / rate-limit controls (Gemini free tier = ~5 requests/minute PER MODEL):
# LLM_AGENTS=diagnosis,supervisor      # only these use the LLM, the others use rules (default: all five)
# LLM_MAX_CONCURRENT=1                 # agents calling the LLM at the same time (default 4)

# Turn the LLM agents on (false = rules only; works with no key). Can also be set in configs/config.yaml.
#LLM_ENABLED=false

# ───────── API ─────────
API_HOST=0.0.0.0
API_PORT=8001
AGENT_API_KEY=98383          # callers must send this as header X-API-Key

# ───────── Backend (Laravel) ─────────
BACKEND_URL=http://localhost:8000
# BACKEND_TOKEN=
# BACKEND_MODE=http              # default mock; switch when the backend team's endpoints exist

# ───────── Other integrations (defaults live in configs/config.yaml) ─────────
# NETWORK_MODE=http
# NETWORK_URL=http://localhost:8300
# NETWORK_TOKEN=
# ANOMALY_MODE=inline            # inline | mock | http | python
# ANOMALY_FUNCTION=src.ml.predict:get_alert_details     # only for ANOMALY_MODE=python

# crewAI anonymous telemetry off
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
