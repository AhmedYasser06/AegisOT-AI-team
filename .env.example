# ───────── LLM (provider-agnostic: Gemini by default; any LiteLLM provider works) ─────────
# Safe default: rules only. Turn the LLM on in YOUR .env after you add a key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-flash-lite-latest
LLM_MAX_CONCURRENT=1
LLM_ENABLED=true
# LLM_MODEL=gemini/gemini-flash-lite-latest      # pin an exact model for reproducible results
# Other providers: LLM_PROVIDER=openai + OPENAI_API_KEY=... | anthropic + ANTHROPIC_API_KEY=... | ollama + LLM_API_BASE=http://localhost:11434

# Only these two roles can use an LLM. network / security / maintenance are rule-only by design.
LLM_AGENTS=diagnosis,supervisor
# direct = ONE LLM call per agent (fast, default) | crewai = tool loop (several LLM rounds, slower)
SPECIALIST_ENGINE=direct
LLM_TIMEOUT_S=30
# Temporary provider errors (Gemini 503 "high demand", 429, timeout) are retried this many times before the rules fallback
LLM_RETRIES=2
LLM_RETRY_BACKOFF_S=1.5
# LLM_FALLBACK_MODEL=gemini/gemini-flash-lite-latest   # tried once if the main model keeps failing
# Optional different model per LLM role:
# LLM_MODEL_DIAGNOSIS=
# LLM_MODEL_SUPERVISOR=

# ───────── ML contract / safety ─────────
# false = stop_equipment is downgraded to inspect_equipment (ML not yet proven on NEW recordings).
# Set true only after the new-recording test passes.
ML_VALIDATED=false
# Used when the ML JSON has no asset_id (single-ESP setup)
DEFAULT_ASSET_ID=esp32-conveyor-01
# Only these telemetry channels are judged (empty = all). Derived: gyro_mag, accel_mag.
# For the real 5 Hz dataset:  TELEMETRY_CHANNELS=temperature_c,gyro_mag
TELEMETRY_CHANNELS=
# How many minutes of telemetry before the ML timestamp the agents look at
# EVIDENCE_WINDOW_MINUTES=2

# ───────── API ─────────
API_HOST=0.0.0.0
API_PORT=8001
AGENT_API_KEY=        # callers must send this as header X-API-Key

# ───────── Backend (Laravel) ─────────
BACKEND_URL=http://localhost:8000
# BACKEND_TOKEN=
# BACKEND_MODE=http              # default mock; switch when the backend team's endpoints exist
PUSH_RESULT_TO_BACKEND=false

# ───────── Other integrations (defaults live in configs/config.yaml) ─────────
# NETWORK_MODE=http
# NETWORK_URL=http://localhost:8300
# NETWORK_TOKEN=
# ANOMALY_MODE=inline            # inline | mock | http | python

# crewAI anonymous telemetry off
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
